        "checkJs": true,
        "allowJs": true,
        "noEmit": true,
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "types": [],
        "strict": true
    },
    "include": [
        "js/thumbhash-init.js",
        "js/hover-preview.js",
        "js/service-worker-register.js",
