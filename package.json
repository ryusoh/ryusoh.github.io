{
    "name": "ryusoh-github-io",
    "version": "1.0.0",
    "private": true,
    "description": "Personal website and portfolio",
    "scripts": {
        "lint": "npm run lint:js && npm run lint:css",
        "lint:js": "eslint . --config eslint.config.cjs --max-warnings=0 --no-warn-ignored",
        "lint:css": "stylelint \"**/*.css\" --config .stylelintrc.cjs --max-warnings=0",
        "fmt": "prettier --write . --config .prettierrc.cjs --ignore-path .prettierignore",
        "fmt:check": "prettier -c . --config .prettierrc.cjs --ignore-path .prettierignore",
        "typecheck:js": "tsc -p jsconfig.json",
        "build:images": "node scripts/build-images.mjs",
        "build:thumbhashes": "node scripts/generate-thumbhashes.mjs",
        "build:assets": "node scripts/build-images.mjs && node scripts/generate-thumbhashes.mjs",
        "page": "node scripts/build-page.mjs",
        "test": "jest --coverage"
    },
    "bin": {
        "page": "./scripts/build-page.mjs"
    },
    "devDependencies": {
        "@babel/core": "^7.29.13",
        "@babel/plugin-transform-modules-commonjs": "^7.29.7",
        "@babel/preset-env": "^7.29.7",
        "@stryker-mutator/core": "^10.1.1",
        "@stryker-mutator/jest-runner": "^10.1.1",
        "@stylistic/stylelint-plugin": "^6.0.1",
        "babel-jest": "^30.5.2",
        "brace-expansion": "^5.0.12",
        "dependency-cruiser": "^18.7.2",
        "eslint": "^10.14.0",
        "gsap": "^3.15.1",
        "jest": "^30.5.2",
        "jest-environment-jsdom": "^30.5.2",
        "js-yaml": "^5.5.0",
        "lenis": "^1.3.27",
        "picomatch": "^4.0.7",
        "prettier": "^3.9.10",
        "sharp": "^0.35.5",
        "stylelint": "^18.0.0",
        "thumbhash": "^0.1.1",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "onnxruntime-node": "^1.31.1"
    }
}
